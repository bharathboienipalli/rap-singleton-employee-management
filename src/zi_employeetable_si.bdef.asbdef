managed with additional save implementation in class ZBP_I_EMPLOYEETABLE_S unique;
strict ( 1 );
with draft;
define behavior for ZI_EmployeeTable_SI alias EmployeeTableAll
draft table ZBR_EMP_TAB_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _EmployeeTable { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
  }

  side effects
  {
    action SelectCustomizingTransptReq affects
        $self;
  }

}

define behavior for ZI_EmployeeTable_BKR alias EmployeeTable ##UNMAPPED_FIELD
persistent table ZBKR_EMP_TAB
draft table zbr_emp_tab_d
lock dependent by _EmployeeTableAll
authorization dependent by _EmployeeTableAll
{
  field ( mandatory : create )
   Empid;

  field ( readonly )
   SingletonID;

  field ( readonly : update )
   Empid;

  field ( notrigger )
   SingletonID;


  update( features : global );
  delete( features : global );

  mapping for ZBR_EMP_TAB
  {
    Empid = EMPID;
    Name = NAME;
    Department = DEPARTMENT;
    City = CITY;
    Salary = SALARY;
    Currency = CURRENCY;
  }

  association _EmployeeTableAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT
  {
    create;
    update;
    delete;
  }

}